<UserControl x:Class="FaraVrcAlbum.Desktop.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- どの画面も同じ見出し: 題と、この画面でできること（利用者向けの説明） -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Accent}" BorderThickness="4,0,0,0"
            CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
        <StackPanel>
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Description, ElementName=Root}" TextWrapping="Wrap" LineHeight="20"/>
        </StackPanel>
    </Border>
</UserControl>
