# コピーして .env.local にし、値を入れる(.env.local は Git 管理外。値をチャット・コミットに出さない)
#   cp .env.example .env.local     (PowerShell: Copy-Item .env.example .env.local)
# 使うのは手元の album ツール(npm run album -- …)。詳細は docs/album-tool.md
# 書式: 名前=値(# から始まる行は無視。値は " または ' で囲んでもよい)

# Cloudflare のアカウント ID(ダッシュボードの右側)
R2_ACCOUNT_ID=

# R2 の API トークン(R2 → Manage API tokens。Object Read & Write、対象は本番と試験用のバケットだけ)
# Secret は作成時にしか表示されない
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 書き込み先のバケット。最初は試験用のままにする(公開ドメインなし)。本番は fara-vrc-photos(省略時もこちら)
# remove / cover は本番バケットだけに使える
R2_BUCKET=fara-vrc-photos-test
