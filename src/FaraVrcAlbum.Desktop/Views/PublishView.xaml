<UserControl x:Class="FaraVrcAlbum.Desktop.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FaraVrcAlbum.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <views:PageHeader Title="公開"
                              Description="今の記事の中身を、サイトとして公開します。先に確認用（dev）へ公開してサイトを確かめ、よければ本番へ公開します。それぞれ、今の内容が公開済みかどうかが分かります。公開には、設定の Cloudflare のトークンが要ります。"/>

            <!-- ワールドの画像・情報（VRChat から）。公開とは別。公開の前に、ここで取っておく -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="サイトの画像・情報" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding WorldsText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="ワールドの画像・情報の状態"/>
                    <TextBlock Text="サイトに出すワールドの画像（Cloudflare R2 に置きます）と情報（訪問数・説明・作者など）を、VRChat の公開 API から、足りない分だけ更新します（1 回ごとに約 1 分おきます）。更新したあとに、確認用（dev）へ公開してください。服の画像・情報（BOOTH）は、「アバター・服」タブの「フォルダから服を読む」で取り込みます。" Style="{StaticResource Note}"/>
                    <CheckBox Content="前に取れなかったワールドも、もう一度取得する" IsChecked="{Binding RetryFailed}" Margin="0,8,0,0"
                              AutomationProperties.Name="前に取れなかったワールドも、もう一度取得する"/>
                    <Button Content="サイトの画像情報を更新する" Command="{Binding FetchWorldsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            AutomationProperties.Name="サイトの画像情報を更新する"/>
                </StackPanel>
            </Border>

            <!-- 確認用（dev） -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="確認用（dev）" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DevText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="確認用の公開の状態"/>
                    <TextBlock Text="https://vrc-album-dev.fara-labs.com/" Style="{StaticResource Note}"/>
                    <Button Content="確認用へ公開する" Command="{Binding PublishDevCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            AutomationProperties.Name="確認用へ公開する"/>
                </StackPanel>
            </Border>

            <!-- 本番 -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="本番" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ProductionText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="本番の公開の状態"/>
                    <TextBlock Text="https://vrc-album.fara-labs.com/" Style="{StaticResource Note}"/>
                    <Button Content="本番へ公開する" Command="{Binding PublishProductionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            AutomationProperties.Name="本番へ公開する"/>
                    <TextBlock Text="{Binding ProductionHint}" Style="{StaticResource Note}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="出力（取得・公開）" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBox x:Name="LogBox" Text="{Binding Log, Mode=OneWay}" TextChanged="LogBox_TextChanged" IsReadOnly="True" FontFamily="Consolas" MinHeight="160" MaxHeight="360"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="取得・公開の出力"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
