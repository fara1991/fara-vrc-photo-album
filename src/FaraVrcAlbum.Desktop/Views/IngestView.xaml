<UserControl x:Class="FaraVrcAlbum.Desktop.Views.IngestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FaraVrcAlbum.Desktop.Views">
    <DockPanel>
        <views:PageHeader DockPanel.Dock="Top" Title="取り込み"
                          Description="PC の VRChat 写真格納フォルダにある写真から、アルバムに載せる写真を選んでアップロードします。月を選ぶと、その月の写真が一覧に出ます（すでにアップロードした写真は、状態の列に「✓ アップロード済み」と出ます）。載せたい写真にチェックを付けて「アップロード」を押すと、枚数を確かめるダイアログが出て、「はい」でアップロードします。元の写真はコピーも移動もせず、そのまま残ります。"/>

        <!-- 操作 -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="月" Style="{StaticResource Label}" Margin="0,0,8,8"/>
            <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Text" Width="150" Margin="0,0,12,8"
                      AutomationProperties.Name="表示する月"/>
            <Button Content="読み直す(_R)" Command="{Binding RefreshCommand}"/>
            <Button Content="アップロード(_U)" Style="{StaticResource Primary}" Command="{Binding UploadCommand}"/>
            <Button Content="中止(_X)" Command="{Binding Plan.CancelCommand}"/>
            <TextBlock Text="{Binding Plan.Progress, StringFormat='進み具合 {0}'}" VerticalAlignment="Center" Margin="10,0,0,8"/>
            <TextBlock Text="{Binding CheckedCount, StringFormat='選択 {0} 枚'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,8"/>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,8"/>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 写真の一覧（見出しを押すと並び替え。Space でチェックを切り替え） -->
            <DataGrid x:Name="InboxList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                      EnableRowVirtualization="True" PreviewKeyDown="InboxList_KeyDown"
                      AutomationProperties.Name="VRChat の写真の一覧">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="64" CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}" HorizontalAlignment="Center"
                                      ToolTip="全部を選ぶ・選択を外す（アップロード済みの写真は選ばない）" AutomationProperties.Name="全部を選ぶ"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="この写真を選ぶ"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="状態" Binding="{Binding StateDisplay}" SortMemberPath="StateText" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUploaded}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="写真名" Binding="{Binding FileName}" Width="2*" MinWidth="200"/>
                    <DataGridTextColumn Header="撮影日時" Binding="{Binding TakenText}" SortMemberPath="TakenAt" Width="170"/>
                    <DataGridTextColumn Header="ワールド" Binding="{Binding WorldText}" Width="*" MinWidth="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 選んだ写真のプレビューと、状態・注意 -->
            <StackPanel Grid.Column="2">
                <views:PhotoPreview Source="{Binding PreviewPath}" Height="290"/>
                <TextBlock Text="{Binding PreviewDetail}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
