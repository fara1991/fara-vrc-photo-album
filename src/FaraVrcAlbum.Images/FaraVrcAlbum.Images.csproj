<Project Sdk="Microsoft.NET.Sdk">

  <!--
    画像パイプライン（M3）: PNG の XMP 読み取り・WebP/JPEG 変換・メタデータ除去・内容ハッシュ・
    R2（S3 互換）への書き込み・台帳。ローカル（手元）のツールだけが使う。ブラウザ・Build には載せない。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraVrcAlbum.Images</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaraVrcAlbum.Shared\FaraVrcAlbum.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FaraVrcAlbum.Images.Tests" />
    <InternalsVisibleTo Include="FaraVrcAlbum.Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.6" />
    <PackageReference Include="NetVips" Version="3.1.0" />
    <PackageReference Include="NetVips.Native" Version="8.18.7" />
  </ItemGroup>

</Project>
