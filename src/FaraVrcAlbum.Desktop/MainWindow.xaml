<Window x:Class="FaraVrcAlbum.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fara Photo Album"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Properties}"/>
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Properties}" Executed="OpenSettings_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Help}" Executed="OpenHelp_Executed"/>
    </Window.CommandBindings>
    <DockPanel>

        <!-- メニューバー（よくあるアプリと同じ: ファイル・表示・設定・ヘルプ。Alt で開ける） -->
        <Menu DockPanel.Dock="Top" AutomationProperties.Name="メニュー">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="PC の VRChat 写真格納フォルダを開く(_P)" Click="OpenSourceFolder_Click"/>
                <Separator/>
                <MenuItem Header="終了(_X)" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="表示(_V)" x:Name="ViewMenu"/>
            <MenuItem Header="設定(_S)">
                <MenuItem Header="設定を開く(_O)…" InputGestureText="Ctrl+," Command="{x:Static ApplicationCommands.Properties}"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="このアプリの使い方(_H)…" InputGestureText="F1" Command="{x:Static ApplicationCommands.Help}"/>
                <Separator/>
                <MenuItem Header="このアプリについて(_A)" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- アプリの説明 -->
        <Border DockPanel.Dock="Top" Padding="14,8" Background="#F3E5F5">
            <TextBlock Text="{Binding AppDescription}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#4A148C"/>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="{Binding Current.Status}" TextWrapping="Wrap" MaxWidth="1000"
                           AutomationProperties.Name="状態"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Alt+1〜6: 画面の切り替え ／ Ctrl+,: 設定 ／ F1: 使い方" Foreground="{StaticResource Muted}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 作業の画面（上のタブ）。画面の中身は App.xaml の DataTemplate（ViewModel → View） -->
        <TabControl x:Name="PageTabs" ItemsSource="{Binding Pages}" DisplayMemberPath="Title" Margin="10,6,10,0"
                    AutomationProperties.Name="画面の切り替え">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding Page}" Margin="6,10,6,10"/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
