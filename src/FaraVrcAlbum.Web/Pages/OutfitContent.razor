@inject AlbumStore Store

@* 服（マスタの id）を着て撮った写真の一覧。服が無い・id の形式が不正・範囲外のページは 404 の画面。 *@
@if (!loaded)
{
    @* 読み込み中は、画面の高さの空きだけを置く（静的 HTML の本文が消えてフッターが上に跳ねるのを防ぐ） *@
    <div class="album-pending" aria-hidden="true"></div>
}
else if (outfit is null || Page < 1 || Page > pageCount)
{
    <PageTitle>見つかりません | @Store.Settings.SiteName</PageTitle>
    <NotFoundView HomeHref="./" NoIndex="false" />
}
else
{
    <PageTitle>@outfit.Name の写真@(Page > 1 ? $"（{Page} ページ目）" : "") | @Store.Settings.SiteName</PageTitle>
    <OutfitPageView Id="@outfit.Id" Name="@outfit.Name" Shop="@outfit.Shop" Url="@outfit.Url" Thumbnail="@outfit.Thumbnail" Description="@outfit.Description" Tags="@outfit.Tags"
                    PublishedAt="@outfit.PublishedAt" UpdatedAt="@outfit.UpdatedAt" FetchedAt="@outfit.FetchedAt" Photos="@SiteRules.Slice(outfit.Photos, Page, Store.Settings.PostsPerPage)"
                    Total="outfit.Photos.Count" BaseUrl="@Store.Settings.ImageBaseUrl" Page="Page" PageCount="pageCount" PerPage="Store.Settings.PostsPerPage" />
}

@code {
    [Parameter] public string Id { get; set; } = "";

    [Parameter] public int Page { get; set; } = 1;

    private OutfitPage? outfit;
    private int pageCount = 1;
    private bool loaded;

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        outfit = await Store.GetOutfitAsync(Id);
        pageCount = SiteRules.PageCount(outfit?.Photos.Count ?? 0, Store.Settings.PostsPerPage);
        loaded = true;
    }
}
