  </ItemGroup>

  <ItemGroup>
    <!-- 合成画像（実写真は使わない）の試験用ヘルパーは Images.Tests と共用 -->
    <Compile Include="..\FaraVrcAlbum.Images.Tests\TestSupport.cs" Link="Shared\TestSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FaraVrcAlbum.Shared\FaraVrcAlbum.Shared.csproj" />
    <ProjectReference Include="..\..\src\FaraVrcAlbum.Content\FaraVrcAlbum.Content.csproj" />
    <ProjectReference Include="..\..\src\FaraVrcAlbum.Images\FaraVrcAlbum.Images.csproj" />
    <ProjectReference Include="..\..\src\FaraVrcAlbum.Tools\FaraVrcAlbum.Tools.csproj" />
  </ItemGroup>

</Project>
