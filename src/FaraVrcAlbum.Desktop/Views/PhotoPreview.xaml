<UserControl x:Class="FaraVrcAlbum.Desktop.Views.PhotoPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- 選んだ写真のプレビュー。枠と「プレビュー」の見出しを常に出す（どこに出るか分かるように）。何も選んでいないときは案内の文字 -->
    <Border BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="6" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" CornerRadius="6,6,0,0" Padding="10,4">
                <TextBlock Text="プレビュー" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
            </Border>
            <Grid Margin="6" MinHeight="120">
                <TextBlock Text="{Binding Placeholder, ElementName=Root}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Image Source="{Binding Source, ElementName=Root, Converter={StaticResource PreviewImage}}" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="写真のプレビュー"/>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
