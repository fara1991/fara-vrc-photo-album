<UserControl x:Class="FaraVrcAlbum.Desktop.Views.ManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FaraVrcAlbum.Desktop.Views">
    <DockPanel>
        <views:PageHeader DockPanel.Dock="Top" Title="管理"
                          Description="サイトに載せた写真の点検と削除を行います。「公開写真の確認」と「写真の点検」は見るだけで、何も変更しません。「写真の削除」は、内容を確かめてから、確認のあとにだけ削除します（元に戻せません）。"/>

        <TabControl>
            <!-- 公開写真の確認: サイトの写真が、記事のデータどおりに表示できるか（サイトを読むだけ） -->
            <TabItem Header="公開写真の確認(_1)">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}"
                               Text="サイトに載っている写真が、正しく表示できる状態かを確かめます（画像が欠けていないか・大きさが合っているか）。確認する写真は、この画面を開くと一覧に出ます。"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <CheckBox Content="記事に入れていない写真も確かめる(_L)" IsChecked="{Binding IncludeLedger}"
                                  VerticalAlignment="Center" Margin="0,0,16,8"/>
                        <Button Content="確認する(_V)" Style="{StaticResource Primary}" Command="{Binding VerifyCommand}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VerifySummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="注記" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding VerifyNotes}" Height="70" Margin="0,0,0,8" AutomationProperties.Name="確認の注記"/>
                    <!-- 右: 選んだ写真のプレビュー（どの写真を調べているかが分かるように） -->
                    <views:PhotoPreview DockPanel.Dock="Right" Width="320" Margin="12,0,0,0" Source="{Binding LinePreviewUrl}"
                                        Placeholder="左の一覧で写真を選ぶと、ここに表示します"/>
                    <GroupBox Header="確認する写真（「確認する」を押すと、写真ごとの結果がここに出ます）">
                        <DataGrid ItemsSource="{Binding VerifyTargets}" SelectedItem="{Binding SelectedLine}" SelectionMode="Single" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True" Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="確認する写真と結果">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="写真" Binding="{Binding Text}" Width="3*"/>
                                <DataGridTextColumn Header="結果" Binding="{Binding Result}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </DockPanel>
            </TabItem>

            <!-- 写真の点検: アップロード済みの写真が、記事で使われているか（読むだけ） -->
            <TabItem Header="写真の点検(_2)">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}"
                               Text="アップロード済みの写真が、どの記事でも使われていないかを調べます。「点検する」を押すと、写真ごとに「使用中（記事名）」か「使われていません」を付けます。"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                        <Button Content="点検する(_A)" Style="{StaticResource Primary}" Command="{Binding AuditCommand}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding AuditSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <views:PhotoPreview DockPanel.Dock="Right" Width="320" Margin="12,0,0,0" Source="{Binding AuditPreviewUrl}"
                                        Placeholder="一覧で写真を選ぶと、ここに表示します"/>
                    <DataGrid ItemsSource="{Binding AuditPhotos}" SelectedItem="{Binding SelectedAuditPhoto}" SelectionMode="Single" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" AutomationProperties.Name="アップロード済みの写真の一覧">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="撮影日時" Binding="{Binding TakenText}" Width="190"/>
                            <DataGridTextColumn Header="ワールド" Binding="{Binding WorldText}" Width="*" MinWidth="140"/>
                            <DataGridTextColumn Header="判定" Binding="{Binding Judgement}" Width="2*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnused}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 写真の削除: 内容を確かめる → 確認ダイアログ → 削除 -->
            <TabItem Header="写真の削除(_3)">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="写真をサイトと記事から削除します。元に戻せません。写っている方から削除を頼まれたときなどに使います。"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,8">
                        <Button Content="写真の一覧を読む(_R)" Command="{Binding RemoveRefreshCommand}"/>
                        <Button Content="内容を確かめる(_P)" Command="{Binding RemovePlanCommand}"/>
                        <Button Content="削除する(_D)" Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}"/>
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox ItemsSource="{Binding Removable}" SelectedItem="{Binding SelectedRemovable}" AutomationProperties.Name="削除できる写真">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" ToolTip="{Binding BlockReason}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <views:PhotoPreview Source="{Binding RemovePreviewUrl}" Height="220" Margin="0,0,0,8"
                                                Placeholder="削除する写真を選ぶと、ここに表示します"/>
                            <TextBox Grid.Row="1" Text="{Binding RemovePlanText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AutomationProperties.Name="削除の内容"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
