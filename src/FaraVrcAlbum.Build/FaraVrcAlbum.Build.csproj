<Project Sdk="Microsoft.NET.Sdk">

  <!--
    公開用の静的ファイル一式を作るコマンド。content/ の記事から、本文入りの静的 HTML・データの JSON・404.html・_redirects・_headers などを書き出す。
    ページごとの head・robots.txt・sitemap.xml・_headers・404.html は、fara-blazor-component の build/build-pages.mjs（Node）に任せる。
    本文の HTML は Pages（Razor クラスライブラリ）を HtmlRenderer で描く（Web と同じ部品。二重実装しない）。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FaraVrcAlbum.Build</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FaraVrcAlbum.Content\FaraVrcAlbum.Content.csproj" />
    <ProjectReference Include="..\FaraVrcAlbum.Shared\FaraVrcAlbum.Shared.csproj" />
    <ProjectReference Include="..\FaraVrcAlbum.Pages\FaraVrcAlbum.Pages.csproj" />
    <!-- 静的 HTML のフッター（kit の SiteFooter を HtmlRenderer で描く。Web と同じ部品。値は Shared の SiteInfo.Configure） -->
    <ProjectReference Include="..\..\external\fara-blazor-component\src\FaraBlazorComponent.Razor\FaraBlazorComponent.Razor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FaraVrcAlbum.Build.Tests" />
  </ItemGroup>

</Project>
